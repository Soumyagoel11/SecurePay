# SecurePay backend environment variables (example). Copy to .env and edit.
# NEVER commit the real .env file or real secrets.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=False

# JWT authentication
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Database. Default is SQLite so the project runs without a MySQL server.
# For MySQL, set DATABASE_URL to a PyMySQL connection string, e.g.:
# DATABASE_URL=mysql+pymysql://securepay:securepay@localhost:3306/securepay
DATABASE_URL=sqlite:///securepay.db

# CORS allowed origins (comma-separated). Use * for local dev only.
CORS_ORIGINS=*

# Fraud decision threshold: risk_score >= threshold => "Suspicious"
FRAUD_THRESHOLD=0.5
